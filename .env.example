# OrderWeb Admin CMS — Phase 0 / Phase 1
# Copy to .env and fill in. Never commit .env.

# --- Admin login ---
# Your email for /owadmin login (Phase 1 will hash the password in the DB)
VITE_ADMIN_EMAIL=admin@gmail.com
# Temporary bootstrap password used only while creating the first admin user
ADMIN_BOOTSTRAP_PASSWORD=admin
# Cookie session encryption (32+ characters)
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret-32chars

# --- Supabase (Postgres + RLS) ---
# Dashboard: https://supabase.com/dashboard
# 1) Run supabase/schema.sql in the SQL editor
# 2) Re-test with supabase/rls_policy_tests.sql
# Public browser keys may use VITE_. NEVER put service-role / SMTP / session secrets under VITE_.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Optional alias used by server code (defaults to VITE_SUPABASE_URL if unset)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Server only — bypasses RLS for admin CMS. Never prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Cloudinary (images) ---
# Dashboard: https://console.cloudinary.com
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# --- Email / SMTP (contact form → inbox) ---
# Configure in Admin → Settings, or set these env vars to override.
CONTACT_TO_EMAIL=mail@orderweb.co.uk
CONTACT_FROM_EMAIL=OrderWeb Website <noreply@orderweb.co.uk>
SMTP_HOST=smtp.yourhost.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=mail@orderweb.co.uk
SMTP_PASSWORD=your-smtp-password

# --- Public site URL (password-reset emails) ---
# Production example: https://orderweb.co.uk
SITE_URL=http://localhost:8080
VITE_SITE_URL=http://localhost:8080

# --- Telnyx SMS (optional MFA backup) ---
# Portal: https://portal.telnyx.com — API key + a number assigned to a Messaging Profile
TELNYX_API_KEY=KEY_xxxxxxxx
TELNYX_FROM_NUMBER=+447700900000
